@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="auth-shell d-flex align-items-center py-5" style="min-height: 70vh;">
    <div class="container">
        <div class="auth-panel p-4 p-md-5 mx-auto shadow-lg rounded-4" style="max-width: 500px; background-color: #1e293b; border: 1px solid #334155; color: #f8fafc;">
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold text-white">Forgot Password?</h1>
                <p class="text-secondary small">Enter your email address to reset your password.</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-15 border-danger text-danger mb-3 rounded-3 small" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label text-light small">Email address</label>
                    <input asp-for="Input.Email" class="form-control bg-dark border-secondary text-light py-2" placeholder="you@university.edu" autocomplete="username" aria-required="true" style="border-color: #475569 !important;" />
                    <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                </div>
                <button type="submit" class="btn w-100 py-3 text-white fw-semibold" style="background-color: #6366f1; border: none; border-radius: 8px;">Reset Password</button>
            </form>
            <div class="text-center mt-3">
                <a asp-page="./Login" class="small text-decoration-none" style="color: #a78bfa;">Back to Login</a>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}