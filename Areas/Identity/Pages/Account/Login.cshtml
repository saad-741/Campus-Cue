@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="auth-shell d-flex align-items-center py-5">
    <div class="container">
        <div class="auth-panel overflow-hidden mx-auto shadow-lg rounded-4" style="max-width: 950px; background-color: #1e293b; border: 1px solid #334155; color: #f8fafc;">
            <div class="row g-0">
                <aside class="col-lg-5 auth-aside p-4 p-md-5 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #4f46e5, #7c3aed); color: white;">
                    <div class="position-relative" style="z-index: 1">
                        <span class="badge rounded-pill text-bg-light mb-4 text-dark">YOUR CAMPUS, CONNECTED</span>
                        <h1 class="display-6 fw-bold" style="letter-spacing: -0.05em">
                            Good to see you again.
                        </h1>
                        <p class="text-white-50 mt-3">
                            Your next idea, event, or new connection is just around the corner.
                        </p>
                    </div>
                    <div class="position-relative mt-5" style="z-index: 1">
                        <div class="small text-white-50">
                            “The best part of campus is the part you haven’t found yet.”
                        </div>
                        <div class="mt-3 fw-semibold">CampusCue community</div>
                    </div>
                </aside>
                <section class="col-lg-7 p-4 p-md-5">
                    <div class="small text-uppercase fw-semibold mb-2" style="color: #a78bfa !important;">Welcome back</div>
                    <h2 class="h2 fw-bold mb-2 text-white" style="letter-spacing: -0.05em">Log in to CampusCue</h2>
                    <p class="text-secondary mb-4">Use your campus account to continue.</p>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-15 border-danger text-danger mb-3 rounded-3 small" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label text-light small">Email address</label>
                            <input asp-for="Input.Email" class="form-control bg-dark border-secondary text-light py-2" placeholder="you@university.edu" autocomplete="email" aria-required="true" style="border-color: #475569 !important;" />
                            <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label text-light small">Password</label>
                            <input asp-for="Input.Password" class="form-control bg-dark border-secondary text-light py-2" placeholder="Enter your password" autocomplete="current-password" aria-required="true" style="border-color: #475569 !important;" />
                            <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input bg-dark border-secondary" asp-for="Input.RememberMe" style="border-color: #475569 !important;" />
                                <label class="form-check-label small text-secondary" asp-for="Input.RememberMe">Remember me</label>
                            </div>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none" style="color: #a78bfa;">Forgot password?</a>
                        </div>
                        <button id="login-submit" type="submit" class="btn w-100 py-3 text-white fw-semibold shadow-sm" style="background-color: #6366f1; border: none; border-radius: 8px;">
                            Log in <span aria-hidden="true">→</span>
                        </button>
                    </form>

                    <div class="text-center text-secondary small mt-4">
                        New to CampusCue?
                        <a class="fw-semibold text-decoration-none" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" style="color: #a78bfa;">Create a student account</a>
                    </div>
                </section>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}