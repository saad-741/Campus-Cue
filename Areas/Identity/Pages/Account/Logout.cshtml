@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<header class="container py-5 text-center text-white">
    <h1>@ViewData["Title"]</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline justify-content-center mt-3" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="btn btn-primary px-4 py-2">Click here to Logout</button>
            </form>
        }
        else
        {
            <p class="text-secondary mt-3">You have successfully logged out of the application.</p>
            <a class="btn btn-outline-light mt-2" asp-controller="Home" asp-action="Index">Return to Home</a>
        }
    }
</header>