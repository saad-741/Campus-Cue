@model CampusCue.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log in";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-shell d-flex align-items-center py-5"><div class="container"><div class="auth-panel overflow-hidden mx-auto" style="max-width:950px"><div class="row g-0">
    <aside class="col-lg-5 auth-aside p-4 p-md-5 d-flex flex-column justify-content-between"><div class="position-relative" style="z-index:1"><span class="badge rounded-pill text-bg-light mb-4">YOUR CAMPUS, CONNECTED</span><h1 class="display-6 fw-bold" style="letter-spacing:-.05em">Good to see you again.</h1><p class="text-white-50 mt-3">Your next idea, event, or new connection is just around the corner.</p></div><div class="position-relative mt-5" style="z-index:1"><div class="small text-white-50">“The best part of campus is the part you haven’t found yet.”</div><div class="mt-3 fw-semibold">CampusCue community</div></div></aside>
    <section class="col-lg-7 p-4 p-md-5"><div class="eyebrow mb-2">Welcome back</div><h2 class="h2 fw-bold mb-2" style="letter-spacing:-.05em">Log in to CampusCue</h2><p class="text-secondary mb-4">Use your campus account to continue.</p>
        <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="you@university.edu" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label"></label><div class="input-group"><input asp-for="Password" class="form-control" id="loginPassword" placeholder="Enter your password" autocomplete="current-password" /><button type="button" class="btn btn-outline-secondary" data-toggle-password="#loginPassword" aria-label="Show or hide password">👁</button></div><span asp-validation-for="Password" class="text-danger small"></span></div>
            <div class="d-flex justify-content-between align-items-center mb-4"><div class="form-check"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label small text-secondary"></label></div></div>
            <button class="btn btn-brand w-100 py-3" type="submit">Log in <span aria-hidden="true">→</span></button>
        </form>
        <div class="text-center text-secondary small mt-4">New to CampusCue? <a asp-action="Register" class="fw-semibold text-decoration-none">Create a student account</a></div>
    </section>
</div></div></div></section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
