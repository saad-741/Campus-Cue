@model CampusCue.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Student signup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-shell d-flex align-items-center py-5"><div class="container"><div class="auth-panel overflow-hidden mx-auto" style="max-width:1040px"><div class="row g-0">
    <aside class="col-lg-4 auth-aside p-4 p-md-5"><div class="position-relative" style="z-index:1"><span class="badge rounded-pill text-bg-light mb-4">STUDENT MEMBERSHIP</span><h1 class="h2 fw-bold" style="letter-spacing:-.05em">Make campus yours.</h1><p class="text-white-50 mt-3">One account brings your event plans, registrations, and campus discoveries together.</p><div class="mt-5"><div class="d-flex gap-3 mb-4"><span class="feature-icon flex-shrink-0">✓</span><div><div class="fw-semibold">Find what's happening</div><div class="small text-white-50">Explore student events around campus.</div></div></div><div class="d-flex gap-3"><span class="feature-icon flex-shrink-0">⌂</span><div><div class="fw-semibold">Keep plans in one place</div><div class="small text-white-50">See your upcoming registrations at a glance.</div></div></div></div></div></aside>
    <section class="col-lg-8 p-4 p-md-5"><div class="eyebrow mb-2">A place to belong</div><h2 class="h2 fw-bold mb-2" style="letter-spacing:-.05em">Create your student account</h2><p class="text-secondary mb-4">Join with your university details. Registration is for students.</p>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" placeholder="e.g. Aisha Khan" autocomplete="name" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" placeholder="you@university.edu" autocomplete="email" /><span asp-validation-for="Email" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="StudentId" class="form-label"></label><input asp-for="StudentId" class="form-control" placeholder="e.g. STU-24018" /><span asp-validation-for="StudentId" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control" placeholder="e.g. Computer Science" /><span asp-validation-for="Department" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="Password" class="form-label"></label><div class="input-group"><input asp-for="Password" class="form-control" id="passwordInput" placeholder="Create a password" autocomplete="new-password" /><button type="button" class="btn btn-outline-secondary" data-toggle-password="#passwordInput" aria-label="Show or hide password">👁</button></div><span asp-validation-for="Password" class="text-danger small"></span></div>
                <div class="col-md-6"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" placeholder="Enter it again" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
            </div>
            <div class="form-text mt-3">Use at least 8 characters, including an uppercase letter, a number, and a symbol.</div>
            <button class="btn btn-brand w-100 py-3 mt-4" type="submit">Create student account <span aria-hidden="true">→</span></button>
        </form>
        <div class="text-center text-secondary small mt-4">Already have an account? <a asp-action="Login" class="fw-semibold text-decoration-none">Log in</a></div>
    </section>
</div></div></div></section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
