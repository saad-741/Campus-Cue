@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var actionName = ViewContext.RouteData.Values["action"]?.ToString();
    var isAuthPage = controllerName == "Account" && (actionName is "Login" or "Register");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CampusCue — discover and join university events." />
    <title>@ViewData["Title"] - CampusCue</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/static/assets/campuscue.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/campuscue-mvc.css" asp-append-version="true" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎓</text></svg>" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg site-nav sticky-top">
        <div class="container py-2">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index"><span class="brand-mark">CC</span><span class="brand-name">CampusCue</span></a>
            @if (isAuthPage)
            {
                <a class="small text-decoration-none text-secondary" asp-controller="Home" asp-action="Index">← Back to home</a>
            }
            else
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicNav" aria-controls="publicNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="publicNav">
                    <div class="navbar-nav mx-auto gap-lg-3">
                        <a class="nav-link @(controllerName == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="nav-link @(controllerName == "Event" ? "active" : "")" asp-controller="Event" asp-action="Index">Discover events</a>
                        <a class="nav-link" href="@Url.Action("Index", "Home")#how-it-works">How it works</a>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3 mt-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin")) { <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-success px-3">Dashboard</a> }
                            else if (User.IsInRole("Organizer")) { <a asp-controller="Organizer" asp-action="Index" class="btn btn-outline-success px-3">Dashboard</a> }
                            else if (User.IsInRole("Student")) { <a asp-controller="Student" asp-action="Index" class="btn btn-outline-success px-3">Dashboard</a> }
                            <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">@Html.AntiForgeryToken()<button type="submit" class="btn btn-brand px-3">Log out</button></form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success px-3">Log in</a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-brand px-3">Join CampusCue <span aria-hidden="true">↗</span></a>
                        }
                    </div>
                </div>
            }
        </div>
    </nav>

    @if (TempData.Peek("Success") is string || TempData.Peek("Error") is string || TempData.Peek("Warning") is string)
    {
        <div class="container pt-3">
            @if (TempData["Success"] is string successMessage) { <div class="alert alert-success alert-dismissible fade show" role="alert">@successMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
            @if (TempData["Error"] is string errorMessage) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@errorMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
            @if (TempData["Warning"] is string warningMessage) { <div class="alert alert-warning alert-dismissible fade show" role="alert">@warningMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
        </div>
    }

    <main>@RenderBody()</main>

    @if (!isAuthPage)
    {
    <footer class="footer py-4 bg-white">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-3">
            <a class="d-flex align-items-center gap-2 text-decoration-none" asp-controller="Home" asp-action="Index"><span class="brand-mark">CC</span><span class="brand-name">CampusCue</span></a>
            <span class="small align-self-center">A little more life between lectures.</span>
            <a class="small align-self-center text-decoration-none" asp-controller="Event" asp-action="Index">Explore campus events</a>
        </div>
    </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
